# 서버만 읽는다. 클라이언트 번들과 API 응답에 넣지 않는다.
# Nuxt 이름(NUXT_TURSO_*) 또는 Turso 이름(TURSO_*) 중 하나를 쓰면 된다.
NUXT_TURSO_DATABASE_URL=libsql://DATABASE.turso.io
NUXT_TURSO_AUTH_TOKEN=
# TURSO_DATABASE_URL=libsql://DATABASE.turso.io
# TURSO_AUTH_TOKEN=
# Vercel env pull이 만드는 이름
# TURSO_DB_URL=libsql://DATABASE.turso.io
# TURSO_DB_TOKEN=
