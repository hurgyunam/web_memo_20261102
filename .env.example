# 서버만 읽는다. 클라이언트 번들과 API 응답에 넣지 않는다.
# Nuxt 이름(NUXT_TURSO_*) 또는 Turso 이름(TURSO_*) 중 하나를 쓰면 된다.
NUXT_TURSO_DATABASE_URL=libsql://DATABASE.turso.io
NUXT_TURSO_AUTH_TOKEN=
# TURSO_DATABASE_URL=libsql://DATABASE.turso.io
# TURSO_AUTH_TOKEN=
# Vercel env pull이 만드는 이름
# TURSO_DB_URL=libsql://DATABASE.turso.io
# TURSO_DB_TOKEN=

# 네이버 메일로 보안코드를 보낸다. SMTP_PASS는 로그인 비밀번호가 아니라 애플리케이션 비밀번호다.
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=465
# SMTP_USER=네이버아이디
# SMTP_PASS=
# MAIL_FROM=네이버아이디@naver.com
# 도메인이 있을 때 Resend를 쓰려면 아래를 채운다. SMTP가 있으면 SMTP를 먼저 쓴다.
# RESEND_API_KEY=
# MAIL_FROM=메모 <mail@example.com>
